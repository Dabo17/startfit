{
  "name": "startfit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "next dev",
    "dev:backend": "convex dev",
    "build": "next build",
    "build:vercel": "convex deploy --typecheck=disable --cmd 'npm run build'",
    "start": "next start"
  },
  "dependencies": {
    "convex": "^1.24.0",
    "next": "^15.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.6.0"
  }
}
